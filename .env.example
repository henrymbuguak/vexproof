# Copy to .env (cp .env.example .env). .env is gitignored; never commit real values.
# `uv run vexproof check-model` tests these settings.

# Muse Spark Open: Meta's open-weight Muse Spark, served by Ollama's cloud.
# No API key needed. Run `ollama signin` and `ollama pull muse-spark-open:cloud` once.
# Every result in this repository was produced with these settings.
VEXPROOF_MODEL_BASE_URL=http://localhost:11434/v1
VEXPROOF_MODEL=muse-spark-open:cloud
VEXPROOF_MODEL_API=chat
VEXPROOF_MODEL_TIMEOUT_S=300
VEXPROOF_MODEL_WORKERS=2

# Hosted Meta Model API: UNTESTED (never run during the hackathon).
# To try it, comment out the five lines above and uncomment these.
# MODEL_API_KEY=
# VEXPROOF_MODEL_BASE_URL=https://api.meta.ai/v1
# VEXPROOF_MODEL=muse-spark-1.1
# VEXPROOF_MODEL_API=responses        # or "chat" if check-model says Responses is unavailable

# Llama on your own machine through Ollama (offline, free, weaker):
# VEXPROOF_MODEL_BASE_URL=http://localhost:11434/v1
# VEXPROOF_MODEL=llama3.1:8b
# VEXPROOF_MODEL_API=chat
# VEXPROOF_MODEL_TIMEOUT_S=600
# VEXPROOF_MODEL_WORKERS=1

# Model options. Answers are recorded per model, so results never mix.
# VEXPROOF_MODEL_MODE=cache           # cache (default) | replay (no calls) | live (no recording)
# VEXPROOF_MODEL_MAX_TOKENS=1000000   # hard token budget per run
# VEXPROOF_PRICE_INPUT_PER_M=         # USD per million tokens (optional, for cost reports)
# VEXPROOF_PRICE_OUTPUT_PER_M=

# Fix commits are fetched with plain git: no GitHub token is needed.

# Optional tuning
# VEXPROOF_MAX_DOWNLOAD_MB=150   # largest package file vexproof will download
# VEXPROOF_WORKERS=8             # parallel downloads and analyses

# Local cache for advisory data, wheels and recorded model responses
VEXPROOF_CACHE_DIR=.vexproof-cache

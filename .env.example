# Copy to .env and fill in. .env is gitignored; never commit real values.

# Meta Model API (needed from Chapter 3 onwards)
MODEL_API_KEY=
VEXPROOF_MODEL_BASE_URL=https://api.meta.ai/v1
VEXPROOF_MODEL=muse-spark-1.1

# GitHub token with public read access only (needed from Chapter 2 for fix commits)
GITHUB_TOKEN=

# Local cache for advisory data, wheels and recorded model responses
VEXPROOF_CACHE_DIR=.vexproof-cache

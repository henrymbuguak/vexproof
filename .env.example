# Copy to .env and fill in. .env is gitignored; never commit real values.

# Meta Model API (needed from Chapter 3 onwards)
MODEL_API_KEY=
VEXPROOF_MODEL_BASE_URL=https://api.meta.ai/v1
VEXPROOF_MODEL=muse-spark-1.1

# Fix commits are fetched with plain git: no GitHub token is needed.

# Optional tuning
# VEXPROOF_MAX_DOWNLOAD_MB=150   # largest package file vexproof will download
# VEXPROOF_WORKERS=8             # parallel downloads and analyses

# Local cache for advisory data, wheels and recorded model responses
VEXPROOF_CACHE_DIR=.vexproof-cache
